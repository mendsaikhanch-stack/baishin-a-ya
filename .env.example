NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider routing
# Үндсэн provider: gemini (үнэгүй), groq (үнэгүй), anthropic (төлбөртэй)
AI_PROVIDER=gemini
# Үндсэн нь унтарвал дараалан туршина (comma-separated)
AI_FALLBACK_PROVIDERS=groq,anthropic

# Google Gemini — https://aistudio.google.com/apikey (үнэгүй)
GOOGLE_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-2.5-flash

# Groq — https://console.groq.com/keys (үнэгүй)
GROQ_API_KEY=
GROQ_MODEL_DEFAULT=llama-3.3-70b-versatile

# Anthropic — https://console.anthropic.com/settings/keys (төлбөртэй)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_STRONG=claude-opus-4-7

# Rate limiting — Upstash Redis (https://upstash.com, үнэгүй tier)
# Хоосон үлдээвэл rate limit идэвхгүй (зөвхөн локал тестэд тохиромжтой).
# Production deploy хийхээс өмнө заавал тохируулна.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Internal estimator API — random long secret. Required by /api/internal/estimate.
INTERNAL_API_SECRET=

# Admin — Supabase-аар нэвтэрсэн хэрэглэгчийн email нь энэ утгатай тэнцэх ёстой.
# Ашиглагдах route-ууд:
#   * /api/admin/recalibrate
#   * /api/admin/orders (захиалга жагсаалт)
#   * /api/admin/orders/[code]/status (төлвийн шилжилт)
#   * /admin/orders UI
ADMIN_EMAIL=

# Resend (https://resend.com/api-keys) — захиалгын мэдэгдэл email-ийг явуулна.
# Хоосон үлдээвэл email явахгүй (best-effort, flow тасрахгүй).
#   * paid     → "Төлбөр баталгаажлаа" email
#   * unlocked → "Тайлан бэлэн боллоо" email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Байшин А-Я <noreply@baishin.mn>"

# Email-д ороход хэрэглэгдэнэ. Production-д https://baishin.mn гэх мэт.
APP_URL=http://localhost:3000

# Банкны мэдээлэл — захиалгын хуудсанд харагдана (NEXT_PUBLIC = клиентэд ил).
# 🔴 Prod-д ЗААВАЛ бодит данс тавь — эс бөгөөс хэрэглэгч төлбөр хийж чадахгүй.
NEXT_PUBLIC_BANK_NAME="Хаан банк"
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER="Байшин А-Я ХХК"
